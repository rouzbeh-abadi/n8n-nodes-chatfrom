{
	"name": "n8n-nodes-chatfrom",
	"version": "0.1.0",
	"description": "Ask your ChatFrom AI chatbots, add pages, texts and Q&As to their knowledge, and read their conversations from n8n.",
	"license": "MIT",
	"homepage": "https://chatfrom.io",
	"keywords": [
		"n8n-community-node-package",
		"chatfrom",
		"chatbot",
		"ai",
		"customer support",
		"knowledge base"
	],
	"author": {
		"name": "Rouzbeh Abadi",
		"email": "rouzbeh@deadpixelstudio.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rouzbeh-abadi/n8n-nodes-chatfrom.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "node -e \"process.env.GITHUB_ACTIONS || (console.error('Releases are published by GitHub Actions when a version tag is pushed; see publish.yml.'), process.exit(1))\" && n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ChatFromApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ChatFrom/ChatFrom.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
